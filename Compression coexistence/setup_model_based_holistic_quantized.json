{
  "schema_version": 1,
  "description": "Quantized holistic MORBO and qNParEGO RTS/STR comparison with the random Pareto-threshold baseline.",
  "configuration_note": "All numerical experiment settings, calibration matrices and optimizer settings are embedded here; the scripts reuse the existing Python simulator.",
  "seed": 42,
  "n_independent_runs": 1,
  "simulated_rewards": true,
  "torch_num_threads": 1,
  "gravity_mean": 9.81,
  "ou_substeps": 5,
  "system_dynamics_parameters": {
    "n_octopi": 40,
    "n_classes": 4,
    "gamma_learn": 20,
    "gamma_break": 10,
    "gamma_req": 10,
    "gamma_heter": 1,
    "gamma_grav": 1,
    "gamma_sync": 1,
    "gamma_epis": 1
  },
  "hyper_parameters": {
    "temperature": 0.001,
    "scaling_constant": 1
  },
  "fitness_margin_bounds": {
    "Cheetah": [
      -10,
      20
    ],
    "Ant": [
      -10,
      20
    ],
    "Leg": [
      -10,
      20
    ],
    "Humanoid": [
      -10,
      20
    ]
  },
  "policy_shapes": {
    "Cheetah": [
      17,
      6,
      64
    ],
    "Ant": [
      105,
      8,
      64
